{
	"name": "@patimweb/dos2-savegame-tools",
	"version": "1.0.27",
	"description": "LSV unpacking and LSF/LSB to LSX conversion for Divinity Original Sin 2 savegames",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"unpack": "node dist/cli.js unpack",
		"convert": "node dist/cli.js convert",
		"start": "node dist/cli.js",
		"pretty": "npx prettier --write '**/*.{js,ts,json,xml,html,css,scss,md,yaml,yml}'",
		"verify": "node dist/scripts/verify-roundtrip.js",
		"verify:quick": "node dist/scripts/verify-roundtrip.js --quick",
		"verify:lsf2lsx": "node dist/scripts/verify-roundtrip.js --lsf2lsx",
		"verify:unpack": "node dist/scripts/verify-roundtrip.js --unpack",
		"convert-stepwise": "node dist/scripts/convert-lsf-stepwise.js",
		"extract": "node dist/cli.js extract-lsx",
		"pack": "node dist/cli.js pack-lsx",
		"verify:lsx-roundtrip": "node dist/scripts/verify-lsx-roundtrip.js"
	},
	"keywords": [
		"dos2",
		"divinity",
		"savegame",
		"lsv",
		"lsf",
		"lsb",
		"lsx",
		"lslib",
		"larian",
		"larian-studios",
		"divinity-original-sin-2"
	],
	"author": "",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"fast-xml-parser": "^5.3.5",
		"fzstd": "^0.1.1",
		"lz4-napi": "^2.9.0",
		"zstd-napi": "^0.0.12"
	},
	"devDependencies": {
		"@prettier/plugin-xml": "^3.4.2",
		"prettier": "^3.8.1",
		"prettier-plugin-sh": "^0.18.0",
		"semantic-release": "^25.0.3",
		"typescript": "^5.9.3"
	}
}
